// ========== 关卡数据 + 运行时 ==========
// 全新关卡库 v2：9 门语言各 1 个独立玩法关卡（JavaScript 为第 2 关「三把钥匙」）
// 设计文档见项目根目录 NewLevels-Design.md
// buildPreview(code) 控制 iframe 内容；check(code, doc, win) 判题
(function () {
  'use strict';

  // 转义用户代码中的 </script>，避免截断 iframe HTML
  function safeCode(code) {
    return String(code).replace(/<\/script>/gi, '<\\/script>');
  }

  // ===== 关卡数据 =====
  const LEVELS = {
    // 1. HTML · 建造师 · 快递分拣
    html: [{
      id: 'html-1', langId: 'html', index: 1,
      title: '快递分拣', subtitle: 'Package Sorter',
      narrative: '你是仓库建造师。传送带送来 3 个包裹（📦 📦 📦），货架却是空的。用 HTML 的列表把它们一件件码上货架。目标：写出一个 <ul> 列表，里面放 3 个 <li>，每个 <li> 写一个包裹名。',
      knowledge: ['<ul> 是无序列表标签，用来装一列物品；<li> 是列表项，一个 <li> 一件物品', '标签成对出现：<ul> 开头、</ul> 结尾，<li> 也一样', '列表项之间的文字会显示在页面上，一 <li> 一物'],
      starterCode: '<!-- 传送带：📦 📦 📦，货架空空如也 -->\n<!-- 写一个 <ul> 列表，放入 3 个 <li> 包裹名，让包裹上架 -->\n',
      solution: '<ul>\n  <li>鼠标</li>\n  <li>键盘</li>\n  <li>耳机</li>\n</ul>',
      hint: '分三步：① 写 <ul> 开头标签；② 在 <ul> 和 </ul> 之间写 3 个 <li> 标签，每个 <li> 里写一个包裹名；③ 写 </ul> 结尾。',
      buildPreview: (code) => `<!DOCTYPE html><html><head><meta charset="utf-8"><style>
        *{margin:0;box-sizing:border-box}
        body{height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20px;
             background:linear-gradient(135deg,#1a1a2e,#0a0e27);font-family:sans-serif;color:#fff}
        .conveyor{font-size:42px;letter-spacing:10px}
        .shelf{display:flex;gap:14px;padding:16px;border:2px dashed rgba(255,255,255,.25);border-radius:12px;
               min-width:320px;justify-content:center;align-items:center;flex-wrap:wrap}
        .slot{width:76px;height:84px;border:2px solid rgba(255,215,0,.55);border-radius:10px;
              display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;
              background:rgba(255,215,0,.08);animation:pop .45s ease;font-size:13px}
        .slot .ic{font-size:26px}
        @keyframes pop{from{transform:scale(.3);opacity:0}to{transform:scale(1);opacity:1}}
        .status{color:#888;font-size:13px;text-align:center;max-width:80%}
        .status.ok{color:#00f5a0}
      </style></head><body>
        <div class="conveyor">📦 📦 📦</div>
        <div class="shelf" id="shelf"></div>
        <div class="status" id="status">传送带来了 3 个包裹…写 <ul> 列表把它们上架</div>
        ${safeCode(code)}
        <script>
          (function(){
            const shelf=document.getElementById('shelf'), status=document.getElementById('status');
            const ul = document.querySelector('ul');
            if(!ul){ status.textContent='📦 等待上架…写一个 <ul> 列表，放入 3 个 <li> 包裹名'; return; }
            const items=[...ul.querySelectorAll('li')].map(li=>li.textContent.trim()).filter(Boolean);
            if(items.length<3){ status.textContent='📦 货架还差 '+(3-items.length)+' 个 <li>，继续写…'; return; }
            items.slice(0,3).forEach(t=>{
              const s=document.createElement('div'); s.className='slot';
              s.innerHTML='<span class="ic">📦</span>'+t; shelf.appendChild(s);
            });
            status.textContent='✓ 3 个包裹全部上架！'; status.classList.add('ok');
          })();
        </script>
      </body></html>`,
      check: (code, doc) => {
        if (!doc) {
          const hasUl = /<ul[\s>][\s\S]*<\/ul>/i.test(code);
          const liCount = (code.match(/<li[\s>]/g) || []).length;
          if (!hasUl) return { passed: false, message: '没有 <ul> 列表。先写 <ul> 开头、</ul> 结尾。' };
          if (liCount < 3) return { passed: false, message: `货架上只有 ${liCount} 个 <li>，还差 ${3 - liCount} 个。` };
          return { passed: true, message: '3 个包裹全部上架！' };
        }
        const ul = doc.querySelector('ul');
        if (!ul) return { passed: false, message: '没有 <ul> 列表。先写 <ul> 开头、</ul> 结尾。' };
        const lis = ul.querySelectorAll('li');
        if (lis.length < 3) return { passed: false, message: `货架上只有 ${lis.length} 个 <li>，还差 ${3 - lis.length} 个。` };
        for (const li of lis) {
          if (!li.textContent.trim()) return { passed: false, message: '有 <li> 是空的，在里面写点字（包裹名）。' };
        }
        return { passed: true, message: '3 个包裹全部上架！' };
      }
    }],

    // 2. CSS · 变形记 · 隐形的信使
    css: [{
      id: 'css-1', langId: 'css', index: 1,
      title: '隐形的信使', subtitle: 'Invisible Courier',
      narrative: '一位信使被魔法隐形了，只剩一团空气。用 CSS 的 opacity 属性让信使现身，他才能把信送出。目标：把 .courier 的 opacity 改成 1（完全不透明），让信使显现。',
      knowledge: ['CSS 用「选择器 .类名」选中元素，再用「属性: 值」改样式', 'opacity 控制透明度：0 完全透明看不见，1 完全不透明', '取值可以写小数，如 0.5 表示半透明'],
      starterCode: '<div class="courier">📮 信使</div>\n<style>\n  .courier {\n    opacity: 0;   /* 信使被魔法隐藏了 */\n    /* 把 opacity 改成 1 让信使现身 */\n  }\n</style>',
      solution: 'opacity: 1;',
      hint: '在 .courier 的花括号里，把 opacity 的值从 0 改成 1。数字 1 代表完全不透明。',
      asyncRecheck: true,
      buildPreview: (code) => `<!DOCTYPE html><html><head><meta charset="utf-8"><style>
        *{margin:0;box-sizing:border-box}
        body{height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:24px;
             background:radial-gradient(circle at 50% 40%,#1a1a3a,#05060d);font-family:sans-serif;color:#fff}
        .courier{font-size:64px;transition:opacity .8s ease;filter:drop-shadow(0 0 18px rgba(124,92,255,.5))}
        .letter{font-size:16px;color:#ffd700;opacity:0;transition:opacity .8s ease .6s;letter-spacing:2px}
        .hint{color:#666;font-size:12px}
      </style></head><body>
        <div class="hint">让隐形的信使现身</div>
        ${safeCode(code)}
        <div class="letter" id="letter">✉️ 这封信终于能送出去了</div>
        <script>
          (function(){
            const c=document.querySelector('.courier'), letter=document.getElementById('letter');
            if(!c) return;
            const op=parseFloat(getComputedStyle(c).opacity);
            if(op>=0.9){ letter.style.opacity='1'; }
          })();
        </script>
      </body></html>`,
      check: (code, doc) => {
        if (!doc) {
          const m = code.match(/opacity\s*:\s*([01](\.\d+)?|\.\d+)\b/i);
          const op = m ? parseFloat(m[1]) : 0;
          if (isNaN(op) || op < 0.9) return { passed: false, message: `信使还是隐形的（当前透明度 ${isNaN(op) ? '未知' : op}）。把 .courier 的 opacity 改成 1。` };
          return { passed: true, message: '信使现身，信件送出！' };
        }
        const c = doc.querySelector('.courier');
        if (!c) return { passed: false, message: '找不到 .courier 元素，检查标签和 class 名。' };
        const cs = doc.defaultView.getComputedStyle(c);
        const op = parseFloat(cs.opacity);
        if (isNaN(op) || op < 0.9) {
          return { passed: false, message: `信使还是隐形的（当前透明度 ${isNaN(op) ? '未知' : op}）。把 .courier 的 opacity 改成 1。` };
        }
        return { passed: true, message: '信使现身，信件送出！' };
      }
    }],

    // 3. JavaScript · 魔法学院 · 三把钥匙（第 2 关，魂类第 1 关通关后进入）
    javascript: [
      {
        id: 'javascript-1', langId: 'javascript', index: 1,
        title: '新手弹幕', subtitle: 'Beginner Barrage',
        narrative: 'Bug 怪物正从右侧逼近，你是一名魔法学院的学徒。用 JavaScript 的 setInterval 让法杖每隔 500 毫秒自动发射一颗魔法弹，把怪物击退。目标：写一个定时器，让 fireBullet() 被反复调用。',
        knowledge: ['setInterval(函数, 毫秒数) 会每隔一段时间重复执行一个函数', '1000 毫秒 = 1 秒，间隔越小发射越快，500 表示每 0.5 秒一次', '把函数作为参数传递时只写函数名、不要加括号（fireBullet 而非 fireBullet()）', '预置的 fireBullet() 每调用一次就发射一颗魔法弹'],
        starterCode: '// 法杖已准备好，调用 fireBullet() 可发射一颗魔法弹\n// 用 setInterval 每 500 毫秒调用一次 fireBullet()\n',
        solution: 'setInterval(fireBullet, 500);',
        hint: '用 setInterval 定时重复执行：第一个参数传要调用的函数名（不要带括号），第二个参数传间隔毫秒数。间隔按题目要求设为 500。',
        asyncRecheck: true,
        buildPreview: (code) => `<!DOCTYPE html><html><head><meta charset="utf-8"><style>
          *{margin:0;box-sizing:border-box}
          body{height:100vh;overflow:hidden;background:linear-gradient(135deg,#0a0e27,#1a1040);font-family:sans-serif;position:relative}
          .mage{position:absolute;left:40px;top:50%;transform:translateY(-50%);font-size:40px}
          .bug{position:absolute;right:60px;top:50%;transform:translateY(-50%);font-size:32px;animation:creep 6s linear infinite}
          @keyframes creep{from{right:60px}to{right:140px}}
          .bullet{position:absolute;width:14px;height:14px;border-radius:50%;background:#f7df1e;
                  box-shadow:0 0 14px #f7df1e;left:80px;top:50%;transform:translateY(-50%);transition:left 0.8s linear}
          .status{position:fixed;top:12px;left:0;right:0;text-align:center;color:#f7df1e;font-size:12px;letter-spacing:2px}
        </style></head><body>
          <div class="status">🧙 法师 vs 🐛 Bug —— 发射魔法弹击退它！</div>
          <div class="mage">🧙</div><div class="bug">🐛</div>
          <script>
            window.__setIntervalCount = 0;
            window.__bullets = 0;
            const _origSI = window.setInterval;
            window.setInterval = function(fn, ms){
              window.__setIntervalCount++;
              window.__lastIntervalMs = ms;
              return _origSI(fn, ms);
            };
            window.fireBullet = function(){
              window.__bullets++;
              const b = document.createElement('div');
              b.className='bullet';
              document.body.appendChild(b);
              requestAnimationFrame(()=>{ b.style.left = '90%'; });
              setTimeout(()=>b.remove(), 900);
            };
            try { ${safeCode(code)} } catch(e){ document.querySelector('.status').textContent='⚠ 代码出错: '+e.message; }
          </script>
        </body></html>`,
        check: (code, doc, win) => {
          const hasSI = /setInterval\s*\(/.test(code);
          if (!hasSI) return { passed: false, message: '没有用到 setInterval。' };
          if (win && typeof win.__setIntervalCount === 'number') {
            if (win.__setIntervalCount < 1) return { passed: false, message: 'setInterval 没有被真正调用。' };
            if (win.__lastIntervalMs && win.__lastIntervalMs > 1000) return { passed: false, message: '间隔太长了，Bug 会先到——试试 500ms。' };
            if (win.__bullets < 1) return { passed: false, message: '魔法弹还没发射，检查是否调用了 fireBullet。' };
            return { passed: true, message: '弹幕成形！Bug 被击退了。' };
          }
          return { passed: true, message: '弹幕成形！' };
        }
      },
      {
        id: 'javascript-2', langId: 'javascript', index: 2,
        title: '三把钥匙', subtitle: 'Three Keys',
        narrative: '结界之门上有 3 个锁孔，但只有一把钥匙是对的。用 JavaScript 的 if 条件判断，找到正确的锁孔打开它。目标：写一个 if 语句，当 key 等于 2 时调用 openLock(2) 开门。',
        knowledge: ['if (条件) { 语句 } 是条件判断：条件成立（为真）时，才执行花括号里的语句', '=== 是比较运算符，判断两边的值是否相等，如 key === 2', '预置了钥匙编号 key 和开锁函数 openLock(编号)，调用它就能开对应锁孔'],
        starterCode: '// 预置：钥匙编号 key = 2，锁孔编号 1 / 2 / 3\n// 写一个 if 判断：当 key 等于 2 时，调用 openLock(2)\n',
        solution: 'if (key === 2) { openLock(2); }',
        hint: '分三步：① 写 if (key === 2) { 开头；② 在花括号里写 openLock(2);；③ 写 } 结尾。=== 是「相等」的意思。',
        asyncRecheck: true,
        buildPreview: (code) => `<!DOCTYPE html><html><head><meta charset="utf-8"><style>
          *{margin:0;box-sizing:border-box}
          body{height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:26px;
               background:radial-gradient(circle at 50% 40%,#1a1040,#0a0e27);font-family:sans-serif;color:#fff}
          .door{width:200px;height:260px;border:3px solid rgba(124,92,255,.6);border-radius:12px;position:relative;
                display:flex;align-items:center;justify-content:center;gap:14px;background:rgba(124,92,255,.06);
                transition:transform .8s ease,box-shadow .8s ease}
          .door.open{transform:translateX(120px);box-shadow:0 0 40px rgba(124,92,255,.6)}
          .lock{width:34px;height:34px;border-radius:50%;border:2px solid rgba(255,255,255,.35);
                display:flex;align-items:center;justify-content:center;font-size:15px;background:rgba(0,0,0,.4)}
          .lock.on{border-color:#ffd700;color:#ffd700;box-shadow:0 0 16px rgba(255,215,0,.7);animation:pop .4s ease}
          @keyframes pop{50%{transform:scale(1.25)}}
          .status{color:#888;font-size:13px;text-align:center;max-width:80%}
          .status.ok{color:#00f5a0}
        </style></head><body>
          <div class="status" id="status">🔑 钥匙编号 key = 2 … 用 if 找到对的锁孔</div>
          <div class="door" id="door">
            <div class="lock" data-n="1">1</div>
            <div class="lock" data-n="2">2</div>
            <div class="lock" data-n="3">3</div>
          </div>
          <script>
            window.__doorOpened = false;
            const key = 2;
            window.openLock = function(n){
              const l = document.querySelector('.lock[data-n="'+n+'"]');
              if (l) l.classList.add('on');
              if (n === key) {
                window.__doorOpened = true;
                document.getElementById('door').classList.add('open');
                document.getElementById('status').textContent='✓ 锁开了！结界之门缓缓开启…';
                document.getElementById('status').classList.add('ok');
              } else {
                document.getElementById('status').textContent='🔑 锁孔 '+n+' 没反应…if 条件该等于 key 的值';
              }
            };
            try { ${safeCode(code)} } catch(e){ document.getElementById('status').textContent='⚠ 代码出错: '+e.message; }
          </script>
        </body></html>`,
        check: (code, doc, win) => {
          if (!/if\s*\(/.test(code)) return { passed: false, message: '还没有用到 if 判断。写：if (key === 2) { openLock(2); }' };
          if (!/key\s*===/.test(code)) return { passed: false, message: 'if 条件里要用 === 比较钥匙编号，例如 key === 2。' };
          if (!/openLock\s*\(/.test(code)) return { passed: false, message: 'if 的花括号里要调用 openLock()，例如 openLock(2);' };
          if (win && typeof win.__doorOpened === 'boolean') {
            if (!win.__doorOpened) return { passed: false, message: '门还没开——检查 if 条件里的编号是不是 key 的值（2）。' };
            return { passed: true, message: '三把钥匙选对了，门开了！' };
          }
          return { passed: true, message: '三把钥匙选对了，门开了！' };
        }
      }
    ],

    // 4. Python · 忍者训练 · Z 字寻宝
    python: [{
      id: 'python-1', langId: 'python', index: 1,
      title: 'Z 字寻宝', subtitle: 'Zig-Zag Hunt',
      narrative: '3×3 的网格上散落着 3 颗星星，排成 Z 字。写一个 for 循环，让忍者沿 Z 字路线走 3 步，收集全部星星。目标：for i in range(3): 循环，循环体里调用 move()。',
      knowledge: ['for i in range(n): 让循环重复 n 次，n=3 就是走 3 步', 'Python 用「缩进」（4 个空格）表示哪些语句属于循环体', '每调用一次 move()，忍者沿 Z 字路线自动走一步并收集脚下的星星'],
      starterCode: '# 星星 ★ ★ ★ 排成 Z 字，忍者站在起点\n# 写 for 循环 + range()，循环体里调用 move()\n',
      solution: 'for i in range(3):\n    move()',
      hint: 'for 循环结构：for 循环变量 in range(次数):，下一行缩进写要重复的语句。次数填 3，循环体里调用 move()。',
      buildPreview: (code) => `<!DOCTYPE html><html><head><meta charset="utf-8"><style>
        *{margin:0;box-sizing:border-box}
        body{height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;
             background:linear-gradient(180deg,#0a1a2e,#0a0e27);font-family:sans-serif;color:#fff}
        .grid{display:grid;grid-template-columns:repeat(3,86px);grid-template-rows:repeat(3,86px);gap:6px;
              background:rgba(55,118,171,.12);padding:10px;border-radius:14px;position:relative}
        .cell{border:1px dashed rgba(55,118,171,.35);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:30px}
        .cell.star{background:rgba(255,215,0,.08)}
        .cell.star.got{background:rgba(0,245,160,.12)}
        .cell .star-ic{opacity:1;transition:opacity .4s ease;transform:scale(1);transition:all .3s ease}
        .cell.got .star-ic{opacity:0;transform:scale(0)}
        .ninja{position:absolute;font-size:34px;transition:all .45s ease;z-index:5;filter:drop-shadow(0 0 8px rgba(55,118,171,.6))}
        .score{color:#ffd700;font-size:15px;letter-spacing:2px;min-height:22px}
        .score.ok{color:#00f5a0}
      </style></head><body>
        <div class="grid" id="grid"></div>
        <div class="score" id="score">收集星星：0 / 3</div>
        <script>
          (function(){
            const grid=document.getElementById('grid'), score=document.getElementById('score');
            const starPos=[[0,2],[1,1],[2,0]];   // Z 字路径上的 3 颗星
            for(let r=0;r<3;r++){ for(let c=0;c<3;c++){
              const cell=document.createElement('div'); cell.className='cell';
              const isStar=starPos.some(p=>p[0]===r&&p[1]===c);
              if(isStar){ cell.classList.add('star'); cell.innerHTML='<span class="star-ic">★</span>'; }
              grid.appendChild(cell);
            }}
            const code = ${JSON.stringify(code)};
            const forMatch = code.match(/for\\s+\\w+\\s+in\\s+range\\s*\\(\\s*(\\d+)\\s*\\)/);
            const moveCount = (code.match(/move\\s*\\(\\s*\\)/g)||[]).length;
            if(!forMatch){ score.textContent='⭐ 等待指令…写 for i in range(3): 让忍者出发'; return; }
            const steps=Math.min(parseInt(forMatch[2],10),3);
            if(moveCount<1){ score.textContent='⭐ 循环体里还差一步——缩进写 move()'; return; }
            score.textContent='执行：for i in range('+steps+'): move()';
            const cells=[...grid.children];
            const path=starPos;
            let got=0;
            for(let i=0;i<steps;i++){
              setTimeout(()=>{
                const [r,c]=path[i];
                const cell=cells[r*3+c];
                const ninja=document.createElement('div'); ninja.className='ninja';
                const rect=cell.getBoundingClientRect(), g=grid.getBoundingClientRect();
                ninja.textContent='🥷';
                ninja.style.left=(rect.left-g.left+25)+'px';
                ninja.style.top=(rect.top-g.top+25)+'px';
                grid.appendChild(ninja);
                if(cell.classList.contains('star')){ cell.classList.add('got'); got++; score.textContent='收集星星：'+got+' / 3'; score.classList.toggle('ok',got>=3); }
              }, (i+1)*450);
            }
          })();
        </script>
      </body></html>`,
      check: (code) => {
        const m = code.match(/for\s+\w+\s+in\s+range\s*\(\s*(\d+)\s*\)/);
        if (!m) return { passed: false, message: '没有找到 for ... in range() 循环。先写：for i in range(3):' };
        if (parseInt(m[1], 10) !== 3) return { passed: false, message: `range() 里的次数是 ${m[1]}，应该写 3（走 3 步收 3 颗星）。` };
        if (!/move\s*\(\s*\)/.test(code)) return { passed: false, message: '循环体里没有调用 move()。在 for 的下一行缩进写：move()' };
        return { passed: true, message: 'Z 字路线走完，星星全收！' };
      }
    }],

    // 5. Vue · 策略棋盘 · 能量仪表
    vue: [{
      id: 'vue-1', langId: 'vue', index: 1,
      title: '能量仪表', subtitle: 'Power Meter',
      narrative: '棋盘上的小队能量见底，所有卡牌灰暗无力。给 player.energy 充能到 100，能量条满格，全体卡牌瞬间激活。目标：给 player.energy 赋一个 ≥ 100 的数值。',
      knowledge: ['Vue 的核心是「响应式」：修改一个数据，依赖它的界面自动刷新，无需手动操作 DOM', '用「对象.属性 = 值」给对象赋值，如 player.energy = 100', '本关用 Proxy 模拟了 Vue 的响应式引擎，赋值时会自动重渲染卡牌'],
      starterCode: '// player 是响应式对象，energy 当前为 0\n// 给它赋一个 ≥ 100 的值，充满能量条\nplayer.energy = 0\n',
      solution: 'player.energy = 100',
      hint: '把 player.energy 的值从 0 改成一个 ≥ 100 的数（如 100、150）。能量条和卡牌会随赋值实时刷新。',
      asyncRecheck: true,
      buildPreview: (code) => `<!DOCTYPE html><html><head><meta charset="utf-8"><style>
        *{margin:0;box-sizing:border-box}
        body{height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:22px;
             background:linear-gradient(135deg,#0a1a2e,#1a2a1e);font-family:sans-serif;color:#fff}
        .meter{width:320px;height:26px;border-radius:999px;background:rgba(255,255,255,.08);border:1px solid rgba(66,184,131,.4);overflow:hidden}
        .bar{height:100%;width:0%;background:linear-gradient(90deg,#42b883,#00f5a0);transition:width .5s ease;border-radius:999px}
        .meter-label{font-size:12px;color:#888;letter-spacing:2px}
        .cards{display:flex;gap:14px}
        .card{padding:14px 22px;border-radius:12px;background:rgba(66,184,131,.12);border:1px solid rgba(66,184,131,.4);
              text-align:center;font-size:14px;transition:all .5s ease;opacity:.35;filter:grayscale(1)}
        .card.on{opacity:1;filter:none;box-shadow:0 0 22px rgba(66,184,131,.5);transform:translateY(-4px)}
        .card .atk{color:#42b883;font-weight:bold;font-size:20px}
        .hint{color:#666;font-size:12px}
      </style></head><body>
        <div class="hint">给 player.energy 充能 ≥ 100</div>
        <div class="meter"><div class="bar" id="bar"></div></div>
        <div class="meter-label" id="label">能量 0 / 100</div>
        <div class="cards" id="cards"></div>
        <script>
          (function(){
            const bases=[10,15,20];
            const cardsEl=document.getElementById('cards');
            const bar=document.getElementById('bar'), label=document.getElementById('label');
            function render(power){
              const pct=Math.min(100,Math.round(power));
              bar.style.width=pct+'%';
              label.textContent='能量 '+Math.min(power,999)+' / 100';
              cardsEl.innerHTML=bases.map((b,i)=>{
                const on=power>=100?' on':'';
                return '<div class="card'+on+'">卡牌 '+(i+1)+'<br>攻击 <span class="atk">'+(b+power)+'</span></div>';
              }).join('');
            }
            const reactive=(obj)=>new Proxy(obj,{ set(t,k,v){ t[k]=v; render(t.energy||0); return true; } });
            const player=reactive({ energy: 0 });
            window.player=player;
            render(0);
            try { ${safeCode(code)} } catch(e){ cardsEl.innerHTML='<div style="color:#ff6b9d">⚠ '+e.message+'</div>'; }
          })();
        </script>
      </body></html>`,
      check: (code, doc) => {
        const m = code.match(/player\.energy\s*=\s*(\d+)/);
        if (!m) return { passed: false, message: '没有给 player.energy 赋值。写：player.energy = 100' };
        if (parseInt(m[1], 10) < 100) return { passed: false, message: `能量只充到 ${m[1]}，需要 ≥ 100。` };
        if (doc) {
          const bar = doc.getElementById('bar');
          if (bar) {
            const w = parseFloat(bar.style.width);
            if (isNaN(w) || w < 100) return { passed: false, message: '能量条还没充满，检查赋值是否生效。' };
          }
        }
        return { passed: true, message: '能量充满，全部卡牌激活！' };
      }
    }],

