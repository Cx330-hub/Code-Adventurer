    java: [{
      id: 'java-1', langId: 'java', index: 1,
      title: '机器人合唱团', subtitle: 'Robot Choir',
      narrative: '舞台上是 3 个沉默的机器人。定义一个 Robot 类，并在类里写一个 sing() 方法——方法写对后，它们就会依次开口合唱。目标：声明 class Robot，并在类内定义 sing() 方法。',
      knowledge: ['class 关键字用于声明一个类（对象蓝图），类名首字母大写', '方法定义在类体内，格式：返回类型 方法名() { 方法体 }', 'void 表示「无返回值」，sing 只需要开口唱歌，用 void 即可'],
      starterCode: 'public class Robot {\n    // 在这里定义 sing() 方法\n}\n',
      solution: 'public class Robot {\n    void sing() { System.out.println("la la la"); }\n}',
      hint: '在 Robot 类的花括号里定义方法：方法名用 sing、无参数。返回类型写 void（表示不返回数值），方法体用一对花括号包裹。',
      buildPreview: (code) => `<!DOCTYPE html><html><head><meta charset="utf-8"><style>
        *{margin:0;box-sizing:border-box}
        body{height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:22px;
             background:radial-gradient(circle at 50% 30%,#2a1230,#0a0e27);font-family:sans-serif;color:#fff}
        .stage{display:flex;gap:30px}
        .robot{font-size:56px;filter:grayscale(1) brightness(.5);transition:all .6s ease;position:relative}
        .robot.on{filter:none;animation:sway 1.2s ease-in-out infinite}
        .robot .note{position:absolute;top:-26px;left:50%;transform:translateX(-50%);font-size:22px;opacity:0;transition:opacity .4s ease}
        .robot.on .note{opacity:1}
        @keyframes sway{0%,100%{transform:rotate(-4deg)}50%{transform:rotate(4deg)}}
        .log{color:#888;font-size:13px;text-align:center;max-width:80%;min-height:20px}
        .log.ok{color:#00f5a0}
      </style></head><body>
        <div class="stage" id="stage">
          <div class="robot">🤖<span class="note">🎵</span></div>
          <div class="robot">🤖<span class="note">🎶</span></div>
          <div class="robot">🤖<span class="note">🎵</span></div>
        </div>
        <div class="log" id="log">机器人沉默中…定义 Robot 类和 sing() 方法唤醒它们</div>
        <script>
          (function(){
            const code = ${JSON.stringify(code)};
            const hasClass = /class\\s+Robot\\b/.test(code);
            const hasMethod = /sing\\s*\\([^)]*\\)\\s*\\{/.test(code);
            const robots=document.querySelectorAll('.robot'), log=document.getElementById('log');
            if(hasClass && hasMethod){
              robots.forEach((r,i)=>setTimeout(()=>r.classList.add('on'), i*400));
              log.textContent='✓ Robot 类与 sing() 就绪 —— 合唱团开唱！';
              log.classList.add('ok');
            } else {
              if(!hasClass) log.textContent='🤖 机器人沉默中…先声明 class Robot';
              else log.textContent='🤖 类已就位，再定义 sing() 方法，它们就会开口';
            }
          })();
        </script>
      </body></html>`,
      check: (code) => {
        if (!/class\s+Robot\b/.test(code)) return { passed: false, message: '没有声明 class Robot。先写：public class Robot { }' };
        if (!/sing\s*\([^)]*\)\s*\{/.test(code)) return { passed: false, message: 'Robot 类里没有 sing() 方法。在花括号里写：void sing() { }' };
        return { passed: true, message: '合唱团开唱！' };
      }
    }],

    // 7. C/C++ · 底层赛车 · 氮气加速
    cpp: [{
      id: 'cpp-1', langId: 'cpp', index: 1,
      title: '氮气加速', subtitle: 'Nitro Boost',
      narrative: '赛车停在维修站，速度表归零。先声明一个 int 变量 speed 赋值，再用 += 运算触发氮气加速，仪表瞬间飙升。目标：声明 int speed = 数字; 再用 speed += 数字;（或 speed = speed + 数字;）做一次加速。',
      knowledge: ['int 是整数类型，声明格式：类型 变量名 = 值;，如 int speed = 60;', '= 是赋值号；语句以分号 ; 结尾', 'x = x + n 可以简写成 x += n，叫「复合赋值」，效果一样'],
      starterCode: '// 第一步：声明 int 变量 speed 并赋一个初始值\n// 第二步：用 speed += 数字 或 speed = speed + 数字 做一次加速\n',
      solution: 'int speed = 60;\nspeed += 100;',
      hint: '写两句：① int speed = 60;（声明变量并给初值）；② speed += 100;（加速）。+= 就是「自己加自己」。',
      buildPreview: (code) => `<!DOCTYPE html><html><head><meta charset="utf-8"><style>
        *{margin:0;box-sizing:border-box}
        body{height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20px;
             background:linear-gradient(180deg,#001a33,#000);font-family:sans-serif;color:#fff;overflow:hidden}
        .car{font-size:60px;transition:transform .3s ease}
        .car.boost{animation:shake .4s ease infinite}
        @keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-4px)}75%{transform:translateX(4px)}}
        .gauge{width:220px;height:110px;border:3px solid #00599c;border-radius:220px 220px 0 0;border-bottom:none;position:relative;overflow:hidden}
        .needle{position:absolute;bottom:0;left:50%;width:4px;height:100px;background:#00f5a0;
                transform-origin:bottom center;transform:rotate(-90deg);transition:transform .8s cubic-bezier(.34,1.56,.64,1)}
        .rpm{color:#00599c;font-family:monospace;font-size:14px;min-height:20px}
        .rpm.ok{color:#00f5a0}
        .flame{font-size:26px;opacity:0;transition:opacity .3s ease}
      </style></head><body>
        <div class="car" id="car">🏎️<span class="flame" id="flame">🔥</span></div>
        <div class="gauge"><div class="needle" id="needle"></div></div>
        <div class="rpm" id="rpm">speed = 0 · 引擎熄火</div>
        <script>
          (function(){
            const code=${JSON.stringify(code)};
            const m=code.match(/int\\s+speed\\s*=\\s*(\\d+)\\s*;/);
            const car=document.getElementById('car'), needle=document.getElementById('needle'),
                  rpm=document.getElementById('rpm'), flame=document.getElementById('flame');
            if(!m){ rpm.textContent='🏎️ 引擎待命…先声明 int speed = 数值;'; return; }
            const base=parseInt(m[1],10);
            let boost=0;
            const bm=code.match(/speed\\s*\\+=?\\s*(\\d+)/);
            if(bm) boost=parseInt(bm[1],10);
            const total=base+boost;
            const deg=-90+Math.min(total,300)/300*180;
            needle.style.transform='rotate('+deg+'deg)';
            rpm.textContent='speed = '+total+(boost>0?' · 氮气加速！':' · 引擎运转');
            rpm.classList.toggle('ok',boost>0);
            if(boost>0){ car.classList.add('boost'); flame.style.opacity='1'; }
          })();
        </script>
      </body></html>`,
      check: (code) => {
        const m = code.match(/int\s+speed\s*=\s*(\d+)\s*;/);
        if (!m) return { passed: false, message: '没找到 int speed = 数值; 语句。先写：int speed = 60;' };
        if (parseInt(m[1], 10) <= 0) return { passed: false, message: 'speed 的初始值要大于 0。' };
        if (!/speed\s*\+=|speed\s*=\s*speed\s*\+/.test(code)) return { passed: false, message: '还没有加速运算。在声明下面写：speed += 100;（或 speed = speed + 100;）' };
        return { passed: true, message: '氮气加速启动，仪表爆表！' };
      }
    }],

